{
  "appData": [
    {
      "name": "LB",
      "description": "Round-robin gateway demo"
    },
    {
      "name": "backend",
      "description": "Two backend runtimes"
    }
  ],
  "flowData": {
    "LB": {
      "main": {
        "steps": [
          {
            "type": "loadBalance",
            "backends": [
              "http://localhost:8082",
              "http://localhost:8083"
            ],
            "var": "backend"
          },
          {
            "type": "http",
            "url": "{{backend}}/home",
            "method": "GET",
            "var": "result"
          },
          {
            "type": "response",
            "body": "{{result}}"
          }
        ]
      }
    },
    "backend": {
      "main": {
        "steps": [
          {
            "type": "response",
            "body": "Backend response"
          }
        ]
      }
    }
  },
  "listenerData": {
    "LB": [
      {
        "id": 1,
        "type": "http",
        "endpoint": "/home",
        "method": "GET",
        "flow": "main"
      }
    ],
    "backend": [
      {
        "id": 2,
        "type": "http",
        "endpoint": "/home",
        "method": "GET",
        "flow": "main"
      }
    ]
  },
